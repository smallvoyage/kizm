{
  "name": "kizm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "bootstrap": "node scripts/bootstrap.mjs",
    "doctor": "node scripts/doctor.mjs",
    "test:doctor": "node --test scripts/doctor.test.mjs",
    "test:unit": "vitest run",
    "verify": "node scripts/verify.mjs",
    "verify:all": "node scripts/verify.mjs --all",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test:e2e": "playwright test",
    "test:e2e:functional": "playwright test --grep-invert @visual --project 'chromium-*'",
    "test:e2e:cross-browser": "playwright test --grep-invert @visual --project firefox-desktop --project webkit-desktop",
    "test:e2e:visual": "PLAYWRIGHT_VISUAL_REGRESSION=true playwright test --grep @visual",
    "test:e2e:visual:update": "PLAYWRIGHT_VISUAL_REGRESSION=true playwright test --grep @visual --update-snapshots",
    "test:e2e:all-error": "FITNESS_FIXTURE_SCENARIO=all-error playwright test e2e/all-error.spec.ts",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "typecheck": "tsc --noEmit",
    "knip": "knip"
  },
  "dependencies": {
    "@notionhq/client": "5.24.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.31.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "3.8.0",
    "server-only": "0.0.1",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "20.19.43",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "knip": "6.32.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "packageManager": "pnpm@10.33.0"
}
